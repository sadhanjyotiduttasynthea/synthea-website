# ---------------------------------------------------------------------------
# Synthea website — build-time environment
#
# The site is a static export, so the only variable is the public URL used in
# canonical links, the sitemap and Open Graph tags. Copy to .env.local if you
# need a different value locally.
#
# Contact form secrets (SMTP password etc.) are NOT environment variables:
# they live in synthea-contact-config.php on the Hostinger server, outside
# public_html. See deploy/synthea-contact-config.example.php.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://syntheatech.com
