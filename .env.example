# ---------------------------------------------------------------------------
# Synthea website — environment variables
# Copy to .env.local for development. In production, set them in the hosting
# panel (Hostinger: Websites → your site → Node.js → Environment variables).
# Never commit real values. None of these are exposed to the browser except
# NEXT_PUBLIC_SITE_URL.
# ---------------------------------------------------------------------------

# Public URL used for canonical links, sitemap and Open Graph (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://syntheatech.com

# --- Contact form delivery -------------------------------------------------
# Where inquiries are sent (comma-separated for several recipients)
CONTACT_TO_EMAIL=sadhan-jyoti.dutta@syntheatech.com

# Sender address. Must belong to a domain verified with your provider.
CONTACT_FROM_EMAIL="Synthea Website <noreply@syntheatech.com>"

# Choose "resend" or "smtp". If omitted, Resend is used when RESEND_API_KEY
# is set, otherwise SMTP when SMTP_HOST is set.
EMAIL_PROVIDER=resend

# Option A — Resend (https://resend.com): create an API key with "Sending" access
RESEND_API_KEY=

# Option B — SMTP (e.g. a Hostinger email mailbox on syntheatech.com)
# Hostinger Email: host smtp.hostinger.com, port 465 (SSL)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Allow an optional technical document (max 8 MB) to be attached to inquiries.
# Files are verified, held in memory and forwarded by email — never stored.
CONTACT_ATTACHMENTS_ENABLED=false
